# Environment Variables Template
# Copy this file to .env for local development (never commit .env!)
# For Netlify production, set these in: Site settings → Environment variables

# OpenWeatherMap API Key (get free key at openweathermap.org/api)
WEATHER_API_KEY=your_api_key_here

# Weather units: 'metric' (Celsius) or 'imperial' (Fahrenheit)
WEATHER_UNITS=metric

# Note: For local testing with Netlify Functions, use:
#   npm install -g netlify-cli
#   netlify dev
# This will run your functions locally with environment variables from .env
